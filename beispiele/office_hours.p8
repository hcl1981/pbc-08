pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- office hours
-- minen und patience fuer den pbc+
-- jan schulz 2026, cc0

mode="title" sel=1 hold=0 tk=0

function _init()
 cls(0)
 print("office hours",0,0,7)
 big={}
 for y=0,4 do
  for x=0,47 do
   if pget(x,y)==7 then add(big,{x,y}) end
  end
 end
 cls(0)
end

function bigtext(x,y,c)
 for p in all(big) do
  rectfill(x+p[1]*2,y+p[2]*2,x+p[1]*2+1,y+p[2]*2+1,c)
 end
end

function _update()
 tk+=1
 if mode~="title" then
  if btn(5) then hold+=1 else hold=0 end
  if hold==45 then mode="title" hold=0 return end
 end
 if mode=="title" then t_update()
 elseif mode=="minen" then m_update()
 else p_update() end
end

function _draw()
 if mode=="title" then t_draw()
 elseif mode=="minen" then m_draw()
 else p_draw() end
 if hold>8 then
  rectfill(0,126,hold*128/45,127,10)
 end
end

function cprint(s,y,c)
 print(s,64-#s*2,y,c)
end

-- titel ------------------------

function t_update()
 if btnp(0) or btnp(1) then sel=3-sel end
 if btnp(4) then
  if sel==1 then m_new() mode="minen"
  else p_new() mode="pat" end
 end
end

function t_draw()
 rectfill(0,0,127,23,1)
 sspr(0,0,128,104,0,24)
 bigtext(18,4,0) bigtext(17,3,10)
 cprint("two games for the break",16,6)
 for b=1,2 do
  local x=b==1 and 8 or 66
  local on=sel==b
  rectfill(x,94,x+53,109,on and 0 or 1)
  rect(x,94,x+53,109,on and 10 or 13)
  if b==1 then
   mine_icon(x+5,98,on and 8 or 13)
   print("minen",x+18,100,on and 7 or 6)
  else
   rectfill(x+4,97,x+11,106,7) rect(x+4,97,x+11,106,6)
   print("a",x+6,99,8)
   print("patience",x+16,100,on and 7 or 6)
  end
 end
 rectfill(0,114,127,127,0)
 print("🅾️ start   ❎ lang: zurueck",6,118,15)
end

function mine_icon(x,y,c)
 c=c or 0
 circfill(x+4,y+4,3,c)
 line(x+4,y,x+4,y+8,c) line(x,y+4,x+8,y+4,c)
 pset(x+3,y+3,7)
end

-- minen ------------------------

mw,mh,mn,cs,ox,oy=12,12,20,9,10,17
numc={12,3,8,1,4,13,0,5}

function idx(x,y) return y*mw+x end
function inb(x,y) return x>=0 and y>=0 and x<mw and y<mh end

function m_new()
 mine={} opn={} flg={} adj={}
 for i=0,mw*mh-1 do
  mine[i]=false opn[i]=false flg[i]=false adj[i]=0
 end
 mcx,mcy=5,5 first=true mover=false mwon=false
 mt=0 nopen=0 boomi=-1 nflag=0
end

function m_place(sx,sy)
 local n=0
 while n<mn do
  local x,y=flr(rnd(mw)),flr(rnd(mh))
  if not mine[idx(x,y)] and (abs(x-sx)>1 or abs(y-sy)>1) then
   mine[idx(x,y)]=true n+=1
  end
 end
 for y=0,mh-1 do
  for x=0,mw-1 do
   local c=0
   for dy=-1,1 do
    for dx=-1,1 do
     if inb(x+dx,y+dy) and mine[idx(x+dx,y+dy)] then c+=1 end
    end
   end
   adj[idx(x,y)]=c
  end
 end
end

function m_open(x,y)
 local i=idx(x,y)
 if opn[i] or flg[i] or mover then return end
 if first then m_place(x,y) first=false mstart=time() end
 if mine[i] then
  boomi=i mover=true
  for j=0,mw*mh-1 do
   if mine[j] and not flg[j] then opn[j]=true end
  end
  return
 end
 local st={x,y}
 while #st>0 do
  local py=st[#st] st[#st]=nil
  local px=st[#st] st[#st]=nil
  local j=idx(px,py)
  if not opn[j] and not flg[j] then
   opn[j]=true nopen+=1
   if adj[j]==0 then
    for dy=-1,1 do
     for dx=-1,1 do
      local nx,ny=px+dx,py+dy
      if inb(nx,ny) and not opn[idx(nx,ny)] then
       add(st,nx) add(st,ny)
      end
     end
    end
   end
  end
 end
 if nopen==mw*mh-mn then
  mwon=true mover=true
  for j=0,mw*mh-1 do
   if mine[j] and not flg[j] then flg[j]=true nflag+=1 end
  end
 end
end

function m_chord(x,y)
 local i=idx(x,y)
 if adj[i]==0 then return end
 local f=0
 for dy=-1,1 do
  for dx=-1,1 do
   if inb(x+dx,y+dy) and flg[idx(x+dx,y+dy)] then f+=1 end
  end
 end
 if f~=adj[i] then return end
 for dy=-1,1 do
  for dx=-1,1 do
   if inb(x+dx,y+dy) then m_open(x+dx,y+dy) end
  end
 end
end

function m_update()
 if not first and not mover then mt=flr(time()-mstart) end
 if mover then
  if btnp(4) then m_new() end
  return
 end
 if btnp(0) then mcx=(mcx-1)%mw end
 if btnp(1) then mcx=(mcx+1)%mw end
 if btnp(2) then mcy=(mcy-1)%mh end
 if btnp(3) then mcy=(mcy+1)%mh end
 local i=idx(mcx,mcy)
 if btnp(4) then
  if opn[i] then m_chord(mcx,mcy) else m_open(mcx,mcy) end
 end
 if btnp(5) and not opn[i] then
  flg[i]=not flg[i]
  nflag+=flg[i] and 1 or -1
 end
end

function m_draw()
 cls(1)
 print("minen",4,5,7)
 mine_icon(46,3)
 print(mn-nflag,58,5,8)
 local s=tostr(min(mt,999))
 print("⧗",98,5,6)
 print(s,124-#s*4,5,10)
 rect(ox-2,oy-2,ox+mw*cs,oy+mh*cs,13)
 for y=0,mh-1 do
  for x=0,mw-1 do
   local i,x0,y0=idx(x,y),ox+x*cs,oy+y*cs
   if opn[i] then
    rectfill(x0,y0,x0+8,y0+8,6)
    rectfill(x0+1,y0+1,x0+8,y0+8,i==boomi and 8 or 7)
    if mine[i] then
     mine_icon(x0,y0)
    elseif adj[i]>0 then
     print(adj[i],x0+3,y0+2,numc[adj[i]])
    end
   else
    rectfill(x0,y0,x0+8,y0+8,6)
    line(x0,y0,x0+7,y0,7) line(x0,y0,x0,y0+7,7)
    line(x0+8,y0+1,x0+8,y0+8,5) line(x0+1,y0+8,x0+8,y0+8,5)
    if flg[i] then
     line(x0+3,y0+2,x0+3,y0+6,0)
     rectfill(x0+4,y0+2,x0+6,y0+4,8)
     line(x0+2,y0+7,x0+5,y0+7,0)
     if mover and not mwon and not mine[i] then
      line(x0+1,y0+1,x0+7,y0+7,8) line(x0+7,y0+1,x0+1,y0+7,8)
     end
    end
   end
  end
 end
 if not mover then
  local x0,y0=ox+mcx*cs,oy+mcy*cs
  rect(x0-1,y0-1,x0+9,y0+9,tk%16<8 and 10 or 9)
 else
  rectfill(16,52,111,76,0)
  rect(16,52,111,76,mwon and 11 or 8)
  cprint(mwon and "geschafft! "..mt.." s" or "bumm!",57,mwon and 11 or 8)
  cprint("🅾️ neues spiel",67,7)
 end
end

-- patience ---------------------

cw,ch,ty,tby=16,22,3,29
rs={"a","2","3","4","5","6","7","8","9","10","j","q","k"}
suit={
 {"01010","11111","11111","01110","00100"},
 {"00100","01110","11111","01110","00100"},
 {"00100","01110","11111","11111","01010"},
 {"00100","01110","11011","11111","00100"}}

function colx(i) return 2+i*18 end
function red(c) return c.s<=2 end

function p_new()
 local d={}
 for s=1,4 do
  for r=1,13 do add(d,{r=r,s=s,up=false}) end
 end
 for i=#d,2,-1 do
  local j=flr(rnd(i))+1
  d[i],d[j]=d[j],d[i]
 end
 tab={}
 for i=1,7 do tab[i]={} end
 for i=1,7 do
  for k=i,7 do add(tab[k],d[#d]) d[#d]=nil end
 end
 for i=1,7 do tab[i][#tab[i]].up=true end
 stock=d waste={} fnd={{},{},{},{}}
 prow,pcol,pk=1,0,1
 held=nil pwon=false conf={}
end

function pile_at(r,c)
 if r==1 then return tab[c+1] end
 if c==0 then return stock end
 if c==1 then return waste end
 if c>=3 then return fnd[c-2] end
end

function nup(p)
 local n=0
 for i=#p,1,-1 do
  if p[i].up then n+=1 else break end
 end
 return n
end

function can_fnd(c,f)
 if #f==0 then return c.r==1 end
 local t=f[#f]
 return t.s==c.s and c.r==t.r+1
end

function can_tab(c,p)
 if #p==0 then return c.r==13 end
 local t=p[#p]
 return t.up and red(t)~=red(c) and c.r==t.r-1
end

function flip_top(p)
 if #p>0 then p[#p].up=true end
end

function take(p,k)
 held={cards={},from=p}
 for i=#p-k+1,#p do add(held.cards,p[i]) end
 for i=1,k do p[#p]=nil end
end

function drop_back()
 for c in all(held.cards) do add(held.from,c) end
 held=nil
end

function check_win()
 local n=0
 for f in all(fnd) do n+=#f end
 if n==52 then pwon=true end
end

function try_place()
 local d=pile_at(prow,pcol)
 local c=held.cards[1]
 local ok=false
 if d and d~=held.from then
  if prow==0 and pcol>=3 then
   ok=#held.cards==1 and can_fnd(c,d)
  elseif prow==1 then
   ok=can_tab(c,d)
  end
 end
 if not ok then drop_back() return end
 for x in all(held.cards) do add(d,x) end
 for t in all(tab) do
  if t==held.from then flip_top(t) end
 end
 held=nil
 check_win()
end

function auto_fnd()
 local p=pile_at(prow,pcol)
 if not p or #p==0 or (prow==0 and pcol~=1) then return end
 local c=p[#p]
 if not c.up then return end
 for f in all(fnd) do
  if can_fnd(c,f) then
   p[#p]=nil add(f,c)
   if prow==1 then flip_top(p) end
   check_win()
   return
  end
 end
end

function p_update()
 if pwon then
  if #conf<60 then
   add(conf,{x=rnd(128),y=-4,v=0.5+rnd(1.5),c=8+flr(rnd(8))})
  end
  for c in all(conf) do
   c.y+=c.v
   if c.y>130 then del(conf,c) end
  end
  if btnp(4) then p_new() end
  return
 end
 if btnp(0) then pcol=(pcol-1)%7 pk=1 end
 if btnp(1) then pcol=(pcol+1)%7 pk=1 end
 if btnp(2) then
  if prow==1 and not held and pk<nup(tab[pcol+1]) then pk+=1
  else prow=0 pk=1 end
 end
 if btnp(3) then
  if prow==0 then prow=1 pk=1
  elseif pk>1 then pk-=1 end
 end
 if btnp(4) then
  if held then try_place() return end
  local p=pile_at(prow,pcol)
  if prow==0 then
   if pcol==0 then
    if #stock>0 then
     local c=stock[#stock] stock[#stock]=nil
     c.up=true add(waste,c)
    else
     while #waste>0 do
      local c=waste[#waste] waste[#waste]=nil
      c.up=false add(stock,c)
     end
    end
   elseif pcol==2 then
    mode="title"
   elseif #p>0 then
    take(p,1)
   end
  elseif #p>0 then
   if not p[#p].up then p[#p].up=true
   else take(p,min(pk,nup(p))) pk=1 end
  end
 end
 if btnp(5) then
  if held then drop_back() else auto_fnd() end
 end
end

function bigsuit(s,x,y,c)
 local b=suit[s]
 for j=1,5 do
  for i=1,5 do
   if sub(b[j],i,i)=="1" then
    rectfill(x+i*2-2,y+j*2-2,x+i*2-1,y+j*2-1,c)
   end
  end
 end
end

function smallsuit(s,x,y,c)
 local b=suit[s]
 for j=1,5 do
  for i=1,5 do
   if sub(b[j],i,i)=="1" then pset(x+i-1,y+j-1,c) end
  end
 end
end

function card(c,x,y,full)
 rectfill(x+1,y,x+cw-2,y+ch-1,c.up and 6 or 7)
 rectfill(x,y+1,x+cw-1,y+ch-2,c.up and 6 or 7)
 if c.up then
  rectfill(x+1,y+1,x+cw-2,y+ch-2,7)
  local k=red(c) and 8 or 0
  print(rs[c.r],x+2,y+2,k)
  smallsuit(c.s,x+cw-6,y+2,k)
  if full then bigsuit(c.s,x+3,y+10,k) end
 else
  sspr(0,104,16,22,x,y)
 end
end

function slot(x,y)
 rect(x+1,y,x+cw-2,y+ch-1,11)
 rect(x,y+1,x+cw-1,y+ch-2,11)
 rectfill(x+1,y+1,x+cw-2,y+ch-2,3)
end

function col_ys(p)
 local fd=#p-nup(p)
 local fu=nup(p)
 local off=7
 if fu>1 then
  off=mid(2,flr((127-tby-ch-fd*3)/(fu-1)),7)
 end
 local ys,y={},tby
 for i=1,#p do
  ys[i]=y
  y+=p[i].up and off or 3
 end
 return ys
end

function p_draw()
 cls(3)
 -- obere reihe
 local x=colx(0)
 if #stock>0 then card(stock[#stock],x,ty,true)
 else
  slot(x,ty) circ(x+7,ty+10,3,11)
 end
 x=colx(1)
 if #waste>0 then card(waste[#waste],x,ty,true) else slot(x,ty) end
 x=colx(2)
 line(x+3,ty+10,x+7,ty+6,11) line(x+8,ty+6,x+12,ty+10,11)
 rect(x+4,ty+10,x+11,ty+15,11)
 for f=1,4 do
  x=colx(f+2)
  local p=fnd[f]
  if #p>0 then card(p[#p],x,ty,true)
  else slot(x,ty) print("a",x+6,ty+8,11) end
 end
 -- tableau
 for i=1,7 do
  local p,x=tab[i],colx(i-1)
  if #p==0 then slot(x,tby) end
  local ys=col_ys(p)
  for j=1,#p do card(p[j],x,ys[j],j==#p) end
 end
 -- cursor
 local cx=colx(pcol)
 local cy,cy2=ty,ty+ch-1
 if prow==1 then
  local p=tab[pcol+1]
  local ys=col_ys(p)
  if #p>0 then
   cy=ys[#p-min(pk,max(1,nup(p)))+1]
   cy2=ys[#p]+ch-1
  else cy=tby cy2=tby+ch-1 end
 end
 if held then
  local hy=prow==0 and ty+6 or cy2-ch+8
  for i,c in pairs(held.cards) do
   card(c,cx+3,hy+(i-1)*7,i==#held.cards)
  end
 else
  local k=tk%16<8 and 10 or 9
  rect(cx-1,cy-1,cx+cw,cy2+1,k)
 end
 if pwon then
  for c in all(conf) do rectfill(c.x,c.y,c.x+1,c.y+2,c.c) end
  rectfill(18,52,109,76,0)
  rect(18,52,109,76,10)
  cprint("gewonnen!",57,10)
  cprint("🅾️ neues spiel",67,7)
 end
end
__gfx__
